  "run_id": "08584237190590805371743163715CU28",
  "workflow": {
    "properties": {
      "provisioningState": "Succeeded",
      "createdTime": "2026-05-04T07:03:14.7409242Z",
      "changedTime": "2026-05-04T10:52:54.2952693Z",
      "state": "Enabled",
      "version": "08584237149112011351",
      "accessEndpoint": "https://prod-23.southindia.logic.azure.com:443/workflows/e12c072047d14c73865b66b5ab62079e",
      "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "parameters": {
          "$connections": {
            "defaultValue": {},
            "type": "Object"
          }
        },
        "triggers": {
          "When_an_HTTP_request_is_received": {
            "type": "Request",
            "kind": "Http",
            "inputs": {
              "schema": {
                "type": "object",
                "properties": {
                  "fileName": {
                    "type": "string"
                  },
                  "folderPath": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "actions": {
          "Condition": {
            "actions": {
              "Get_file_content_using_path": {
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['googledrive']['connectionId']"
                    }
                  },
                  "method": "get",
                  "path": "/datasets/default/GetFileContentByPath",
                  "queries": {
                    "path": "@{triggerBody()?['folderPath']}@{triggerBody()?['fileName']}",
                    "inferContentType": true,
                    "queryParametersSingleEncoded": true
                  }
                }
              },
              "Send_an_email_(V2)": {
                "runAfter": {
                  "Get_file_content_using_path": [
                    "Succeeded"
                  ]
                },
                "type": "ApiConnection",
                "inputs": {
                  "host": {
                    "connection": {
                      "name": "@parameters('$connections')['office365']['connectionId']"
                    }
                  },
                  "method": "post",
                  "body": {
                    "To": "thiruniraiselvi.m@kaaviansys.com",
                    "Subject": "Excel File - @{triggerBody()?['fileName']}",
                    "Body": "<p>Hi, Please find the attached Excel file @{triggerBody()?['fileName']}</p>",
                    "Attachments": [
                      {
                        "Name": "@triggerBody()?['fileName']",
                        "ContentBytes": "@base64(body('Get_file_content_using_path'))"
                      }
                    ],
                    "Importance": "Normal"
                  },
                  "path": "/v2/Mail"
                }
              },
              "Response_Success": {
                "runAfter": {
                  "Send_an_email_(V2)": [
                    "Succeeded"
                  ]
                },
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": 200,
                  "body": {
                    "status": "success",
                    "message": "File @{triggerBody()?['fileName']} sent successfully"
                  }
                }
              },
              "Response_Email_Failure": {
                "runAfter": {
                  "Send_an_email_(V2)": [
                    "Failed"
                  ]
                },
                "type": "Response",
                "kind": "Http",
                "inputs": {
                  "statusCode": 500,
                  "body": {
                    "status": "failed",
                    "error": {
                      "code": "ERR_EMAIL_FAILED",
                      "message": "Invalid or unreachable email address"
                    }
                  }
                }
              }
            },
            "runAfter": {},
            "else": {
              "actions": {
                "Response_Invalid_File_Type": {
                  "type": "Response",
                  "kind": "Http",
                  "inputs": {
                    "statusCode": 400,
                    "body": {
                      "status": "failed",
                      "error": {
                        "code": "ERR_INVALID_FILE_TYPE",
                        "message": "Only .xlsx and .csv files are allowed"
                      }
                    }
                  }
                }
              }
            },
            "expression": {
              "or": [
                {
                  "endsWith": [
                    "@triggerBody()?['fileName']",
                    ".xlsx"
                  ]
                },
                {
                  "endsWith": [
                    "@triggerBody()?['fileName']",
                    ".csv"
                  ]
                }
              ]
            },
            "type": "If"
          }
        },
        "outputs": {}
      },
      "parameters": {
        "$connections": {
          "type": "Object",
          "value": {
            "googledrive": {
              "id": "/subscriptions/4876617b-2198-4d34-8548-850ce504e7c8/providers/Microsoft.Web/locations/southindia/managedApis/googledrive",
