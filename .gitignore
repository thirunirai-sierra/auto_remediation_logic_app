.env
.env.*
.env.local
.env.development
.env.production.local
.env.test.local

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Build/test artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/
dist/
build/
*.egg-info/
*.tsbuildinfo

# Logs and runtime artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
workflow_backup_*.json
*.backup.json
backups/

# OS/editor artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temporary folders
tmp/
output/

# Node.js / frontend artifacts
node_modules/
client/node_modules/
client/dist/
client/.vite/
client/.cache/
client/coverage/

# Python runtime artifacts (server)
server/__pycache__/
server/**/*.pyc

# Keep required tracked files explicit
!requirements.txt
!requirement1.txt
!agent/knowledge/*.jsonl
